{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Reline Configurator",
  "version": "3.0.0",
  "identifier": "com.rewaifu.reline-gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Reline Configurator",
        "width": 1200,
        "height": 700,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Reline Configurator",
        "url": "splashscreen.html",
        "width": 380,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true,
        "shadow": true,
        "visible": true,
        "backgroundColor": "#0b0b0d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
